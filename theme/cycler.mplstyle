# Matplotlib style matching the cycler Typst theme. Register the fonts in fonts/ first
# (see example/plots/resonance.py), then plt.style.use() this file.

# Colors from matplotlib's fivethirtyeight style. Slots 3 and 4 (gold e5ae38, green 6d904f) are
# swapped for a brighter green 68dc9b and yellow ffdf54:
# https://matplotlib.org/stable/gallery/style_sheets/fivethirtyeight.html
axes.prop_cycle: cycler('color', ['008fd5', 'fc4f30', '68dc9b', 'ffdf54', '8b8b8b', '810f7c'])

font.family: sans-serif
font.sans-serif: Roboto, DejaVu Sans, sans-serif
font.monospace: Roboto Mono, DejaVu Sans Mono, monospace
font.size: 14

mathtext.fontset: custom
mathtext.rm: Fira Math
mathtext.it: Fira Math:italic
mathtext.bf: Fira Math:bold
mathtext.sf: Fira Math
mathtext.cal: Fira Math
mathtext.fallback: cm
axes.formatter.use_mathtext: false  # plain Roboto ticks; mathtext ticks misalign as SVG text

text.color: 1a1a1a
axes.labelcolor: 1a1a1a
xtick.color: 4d4d4d
ytick.color: 4d4d4d
axes.edgecolor: 1a1a1a
axes.linewidth: 1.2
axes.xmargin: 0
axes.grid: true
axes.spines.top: false
axes.spines.right: false
grid.alpha: 0.3
grid.linestyle: --
grid.linewidth: 0.6

lines.linewidth: 2
lines.markersize: 5

legend.frameon: false
legend.fontsize: 12

figure.figsize: 6.4, 3.6  # 16:9, so text stays readable once scaled onto a slide
figure.autolayout: true

# Transparent SVG, so the figure sits on any slide background
savefig.format: svg
savefig.transparent: true
savefig.bbox: tight
svg.fonttype: none  # keep text as <text>, so it stays selectable once Typst embeds the figure
svg.hashsalt: cycler  # stable element ids, so an unchanged plot gives an unchanged file
